// ===================================================================
// 1. IMPORTACIONES Y CONFIGURACION INICIAL
// ===================================================================

import java_cup.runtime.*;
import java.io.*;
import java.util.*;

// ===================================================================
// 2. CODIGO DE USUARIO (ACCIONES Y AUXILIARES)
// ===================================================================
parser code {:

    // ---------------------------------------------------------------
    // 2.1 ANALISIS SINTACTICO (Estructuras de datos para parsing)
    // ---------------------------------------------------------------

    // Almacena info de una variable: nombre, tipo y linea donde se declara
    static class Simbolo {
        String nombre;
        String tipo;
        int linea;

        Simbolo(String nombre, String tipo, int linea) {
            this.nombre = nombre;
            this.tipo   = tipo;
            this.linea  = linea;
        }
    }

    // Pila de tablas de simbolos (un HashMap por cada ambito)
    static java.util.Stack<java.util.HashMap<String, Simbolo>> pilaTablas = new java.util.Stack<>();

    static java.util.HashMap<String, java.util.ArrayList<String>> tablaParametros = new java.util.HashMap<>();
    static java.util.ArrayList<String> parametrosActuales = new java.util.ArrayList<>();
    static java.util.HashMap<String, String> tablaFunciones = new java.util.HashMap<>();
    static java.util.ArrayList<String> argumentosActuales = new java.util.ArrayList<>();
    static String ultimoTipo = "int";

    // Pila con los nombres de cada ambito (para reportes)   
    static java.util.Stack<String> nombresAmbitos = new java.util.Stack<>();

    // Tipo de la variable que se esta declarando actualmente
    static String tipoDeclaracionActual = "";

    static String tipoFuncionActual = "";

    // Contadores para nombrar bloques, switch, if, else, do-while
    static int contadorBloques = 0;
    static int contadorSwitch = 0;
    static int contadorIf = 0;
    static int contadorElse = 0;
    static int contadorWhile = 0;
    static int nivelBreak = 0;
    // Nombre del bloque actual (ej: "IF 1", "SWITCH 2", etc.)
    static String nombreBloqueActual = "BLOQUE";

    // Switch y caso que se estan procesando actualmente
    static int switchActual = 0;
    static int casoActual = 0;

    // Contador de errores sintacticos
    public static int erroresSintacticos = 0;
    
    // Lista que guarda todas las tablas de simbolos para imprimir al final
    static java.util.ArrayList<AmbitoInfo> todasLasTablas = new java.util.ArrayList<>();
    
    // Guarda la info de un ambito (nombre, tabla y nivel de anidamiento)
    static class AmbitoInfo {
        String nombre;
        java.util.HashMap<String, Simbolo> tabla;
        int nivel;
        
        AmbitoInfo(String nombre, java.util.HashMap<String, Simbolo> tabla, int nivel) {
            this.nombre = nombre;
            this.tabla = tabla;
            this.nivel = nivel;
        }
    }

    // Agrega un nuevo ambito a la pila
    public static void pushScope(String nombre) {
        pilaTablas.push(new java.util.HashMap<>());
        nombresAmbitos.push(nombre);
    }
    
    // Elimina el ambito actual y lo guarda para imprimir despues
    public static void popScope() {
        if (!pilaTablas.isEmpty()) {
            java.util.HashMap<String, Simbolo> ambito = pilaTablas.pop();
            String nombre = nombresAmbitos.pop();
            int nivel = nombresAmbitos.size();
            
            // GUARDAR en todasLasTablas
            todasLasTablas.add(new AmbitoInfo(nombre, ambito, nivel));
        }
    }

    // Llamar al final del programa para imprimir todo ordenado
    public static void imprimirTodasLasTablas() {
        // Imprimir en orden inverso (del mas externo al mas interno)
        for (int i = todasLasTablas.size() - 1; i >= 0; i--) {
            AmbitoInfo a = todasLasTablas.get(i);
            
            String indentacion = "";
            for (int j = 0; j < a.nivel; j++) {
                indentacion += "               ";
            }
            
            System.out.println("\n" + indentacion + "=== TABLA DE SIMBOLOS: " + a.nombre + " ===");
            imprimirTabla(a.tabla, indentacion + "  ");
        }
        todasLasTablas.clear(); // Limpiar por si acaso
    }

    // Registra una nueva variable en la tabla del ambito actual
    public static void agregarSimbolo(String nombre, String tipo, int linea) {
        if (pilaTablas.isEmpty()) return;
        java.util.HashMap<String, Simbolo> ambito = pilaTablas.peek();
        if (ambito.containsKey(nombre)) {
            errorSemantico("Linea " + linea + ": variable '" + nombre + "' ya fue declarada en este ambito.");
        } else {
            ambito.put(nombre, new Simbolo(nombre, tipo, linea));
        }
    }

    // Muestra el contenido de una tabla de simbolos
    private static void imprimirTabla(java.util.HashMap<String, Simbolo> tabla, String indentacion) {
        if (tabla.isEmpty()) {
            System.out.println(indentacion + "(sin variables)");
            return;
        }
        System.out.println(indentacion + String.format("%-20s %-10s %s", "Variable", "Tipo", "Linea"));
        System.out.println(indentacion + String.format("%-20s %-10s %s", "--------", "----", "-----"));
        for (java.util.Map.Entry<String, Simbolo> e : tabla.entrySet()) {
            Simbolo s = e.getValue();
            System.out.println(indentacion + String.format("%-20s %-10s %s", s.nombre, s.tipo, s.linea));
        }
    }
    
    // Manejador de errores sintacticos (token inesperado)
    public void syntax_error(java_cup.runtime.Symbol s) {
        erroresSintacticos++;
        System.err.println("[ERROR SINTACTICO] Linea " + s.left + ", columna " + s.right
                + ": token inesperado -> '" + s.value + "'");
    }

    public static void actualizarTipoSimbolo(String nombre, String nuevoTipo) {
        for (java.util.HashMap<String, Simbolo> ambito : pilaTablas) {
            if (ambito.containsKey(nombre)) {
                ambito.get(nombre).tipo = nuevoTipo;
                return;
            }
        }
    }

    // Manejador de errores sintacticos irrecuperables
    public void unrecovered_syntax_error(java_cup.runtime.Symbol s) {
        erroresSintacticos++;
        System.err.println("[ERROR SINTACTICO IRRECUPERABLE] Linea " + s.left
                + ": no se pudo continuar el analisis.");
    }

    // ---------------------------------------------------------------
    // 2.2 ANALISIS SEMANTICO (Validaciones)
    // ---------------------------------------------------------------
    
    // Contador de errores semanticos
    public static int erroresSemanticos = 0;

    // Reporta y cuenta un error semantico
    public static void errorSemantico(String mensaje) {
        erroresSemanticos++;
        System.err.println("[ERROR SEMANTICO] " + mensaje);
    }

    // Busca un simbolo en toda la pila de tablas (de interna a externa)
    public static Simbolo buscarSimbolo(String nombre) {
        for (java.util.HashMap<String, Simbolo> ambito : pilaTablas) {
            if (ambito.containsKey(nombre)) return ambito.get(nombre);
        }
        return null;
    }

    // Verifica que una variable exista antes de usarla. Retorna su tipo si existe, o "error" si no
    public static String verificarUso(String nombre, int linea) {
        Simbolo s = buscarSimbolo(nombre);
        if (s == null) {
            errorSemantico("Linea " + linea + ": variable '" + nombre + "' no fue declarada.");
            return "error|?";
        }
        return s.tipo + "|" + nombre;
    }

    // Compara si dos tipos son compatibles en una asignacion
    public static String validarTipos(String tipo1, String tipo2, String operacion, int linea) {
        
        // Extraer solo el tipo si viene con temporal
        String t1 = tipo1;
        String t2 = tipo2;
        
        // Si contiene '|', tomar la parte antes del pipe (el tipo)
        if (tipo1 != null && tipo1.contains("|")) {
            t1 = tipo1.split("\\|")[0];
        }
        if (tipo2 != null && tipo2.contains("|")) {
            t2 = tipo2.split("\\|")[0];
        }
        
        // Manejar casos donde el tipo es "error" (viene de una variable no declarada)
        if (t1.equals("error") || t2.equals("error")) return "error|?";
        
        
        if (!t1.equals(t2)) {
            if (operacion.equals("asignacion")) {
                errorSemantico("Linea " + linea 
                    + ": tipo incompatible en asignacion, se esperaba '" + t1 
                    + "' pero se encontro '" + t2 + "'.");
            } else if (operacion.equals("return")) {
                errorSemantico("Linea " + linea 
                    + ": tipo de retorno incorrecto, se esperaba '" + t1 
                    + "' pero se encontro '" + t2 + "'.");
            } else {
                errorSemantico("Linea " + linea 
                    + ": tipos incompatibles en operacion '" + operacion 
                    + "', se encontraron '" + t1 + "' y '" + t2 + "'.");
            }
            return "error|?";
        }
        
        // Para operadores relacionales, devuelve bool
        if (operacion.equals("less_t") || operacion.equals("less_te") || 
            operacion.equals("greather_t") || operacion.equals("greather_te") ||
            operacion.equals("equal") || operacion.equals("n_equal")) {
            return "bool|?";
        }
        
        // Para otros casos (asignacion, return, aritmetica)
        return t1 + "|?";
    }
:}

/* Terminales */
terminal PALABRA_MAIN, INT, FLOAT, BOOL, CHAR, STRING;
terminal IF, ELSE, DO, WHILE, SWITCH, CASE, DEFAULT;
terminal RETURN, BREAK, CIN, COUT;
terminal EQUAL, N_EQUAL, LESS_T, LESS_TE, GREATER_T, GREATER_TE;
terminal ASIGNACION, SEPARADOR, DELIMITADOR_EXP, INICIO_BLOQUE, FIN_BLOQUE;
terminal INICIO_PARENTESIS, FIN_PARENTESIS, INICIO_INDICE, FIN_INDICE, COMA;
terminal DOS_PUNTOS, MAS, MENOS, MULTIPLICACION, DIVISION;
terminal NUMERO_ENTERO, NUMERO_FLOTANTE, NOTACION_CIENTIFICA, FRACCIONARIO;
terminal CADENA, CARACTER, BOOLEANO, IDENTIFICADOR, EMPTY;
terminal MODULO, POTENCIA, INCREMENTO, DECREMENTO, OPERADOR_LOGICO_BINARIO, OPERADOR_LOGICO_UNARIO;

/* No terminales */
non terminal programa, funcion_main, contenido_programa;
non terminal String numero;
non terminal funcion, lista_funciones, parametros, lista_parametros, parametro, parametro_resto;
non terminal sentencia, lista_sentencias;
non terminal declaracion, declaracion_variable_resto;
non terminal String lista_valores, valor_lista;
non terminal String llamada_funcion_exp;
non terminal asignacion, return_sentencia, break_sentencia;
non terminal cin_sentencia, cout_sentencia, lista_escritura, elemento_escritura;
non terminal if_sentencia, do_while_sentencia, switch_sentencia;
non terminal lista_casos, lista_caso_simple, caso, caso_default;
non terminal String expresion, exp_logica, resto_logica;
non terminal String exp_relacional, exp_aritmetica, resto_aritmetica;
non terminal String exp_termino, resto_termino, exp_potencia, resto_potencia;
non terminal String exp_factor, valor;
non terminal String array;
non terminal String acceso_arreglo;
non terminal argumentos, lista_argumentos, bloque_simple, bloque_inicio;
non terminal casoConstante, if_cabeza, else_cabeza, while_cabeza;
non terminal String declaracion_resto;

/* Reglas gramaticales */
start with programa;

numero ::= NUMERO_ENTERO:n
            {:
                String t = GeneradorCodigo.nuevoTemp();
                GeneradorCodigo.emitir("    " + t + " = " + n);
                RESULT = "int|" + t;
            :}
         | NUMERO_FLOTANTE:n
            {:
                String t = GeneradorCodigo.nuevoTemp();
                GeneradorCodigo.emitir("    " + t + " = " + n);
                RESULT = "float|" + t;
            :}
         | NOTACION_CIENTIFICA:n
            {:
                String t = GeneradorCodigo.nuevoTemp();
                GeneradorCodigo.emitir("    " + t + " = " + n);
                RESULT = "float|" + t;
            :}
         | FRACCIONARIO:n
            {:
                String t = GeneradorCodigo.nuevoTemp();
                GeneradorCodigo.emitir("    " + t + " = " + n);
                RESULT = "float|" + t;
            :} ;
/* Para case - solo constantes literales (sin variables) */
casoConstante ::= numero | CADENA | BOOLEANO | CARACTER ;

/* Main */
programa ::= lista_funciones {: pushScope("GLOBAL (MAIN)"); :} funcion_main {: popScope(); imprimirTodasLasTablas(); :} ;

funcion_main ::= EMPTY SEPARADOR PALABRA_MAIN SEPARADOR INICIO_PARENTESIS FIN_PARENTESIS INICIO_BLOQUE contenido_programa FIN_BLOQUE ;
contenido_programa ::= lista_sentencias ;

/* Funciones  */
funcion ::= INT SEPARADOR IDENTIFICADOR:id
              {: tablaFunciones.put((String)id, "int"); tipoFuncionActual = "int"; parametrosActuales = new java.util.ArrayList<>(); pushScope((String)id); :}
              INICIO_PARENTESIS parametros FIN_PARENTESIS INICIO_BLOQUE lista_sentencias FIN_BLOQUE
              {: tablaParametros.put((String)id, new java.util.ArrayList<>(parametrosActuales)); popScope(); :}
          | FLOAT SEPARADOR IDENTIFICADOR:id
              {: tablaFunciones.put((String)id, "float"); tipoFuncionActual = "float"; parametrosActuales = new java.util.ArrayList<>(); pushScope((String)id); :}
              INICIO_PARENTESIS parametros FIN_PARENTESIS INICIO_BLOQUE lista_sentencias FIN_BLOQUE
              {: tablaParametros.put((String)id, new java.util.ArrayList<>(parametrosActuales)); popScope(); :}
          | BOOL SEPARADOR IDENTIFICADOR:id
              {: tablaFunciones.put((String)id, "bool"); tipoFuncionActual = "bool"; parametrosActuales = new java.util.ArrayList<>(); pushScope((String)id); :}
              INICIO_PARENTESIS parametros FIN_PARENTESIS INICIO_BLOQUE lista_sentencias FIN_BLOQUE
              {: tablaParametros.put((String)id, new java.util.ArrayList<>(parametrosActuales)); popScope(); :}
          | CHAR SEPARADOR IDENTIFICADOR:id
              {: tablaFunciones.put((String)id, "char"); tipoFuncionActual = "char"; parametrosActuales = new java.util.ArrayList<>(); pushScope((String)id); :}
              INICIO_PARENTESIS parametros FIN_PARENTESIS INICIO_BLOQUE lista_sentencias FIN_BLOQUE
              {: tablaParametros.put((String)id, new java.util.ArrayList<>(parametrosActuales)); popScope(); :}
          | STRING SEPARADOR IDENTIFICADOR:id
              {: tablaFunciones.put((String)id, "string"); tipoFuncionActual = "string"; parametrosActuales = new java.util.ArrayList<>(); pushScope((String)id); :}
              INICIO_PARENTESIS parametros FIN_PARENTESIS INICIO_BLOQUE lista_sentencias FIN_BLOQUE
              {: tablaParametros.put((String)id, new java.util.ArrayList<>(parametrosActuales)); popScope(); :} ;

/*Lista de 0 o mas funciones*/
lista_funciones ::= funcion lista_funciones | /* vacio */ ;

/* Lista de parametros de una funcion (puede estar vacia) */
parametros ::= lista_parametros | /* vacio */ ;

/* Lista de parametros separados por coma */
lista_parametros ::= parametro | parametro COMA lista_parametros ;

/* FIX: factorizado con parametro_resto para evitar conflictos y reducir repeticion */
parametro ::= INT SEPARADOR IDENTIFICADOR:id parametro_resto
                {: agregarSimbolo((String)id, "int", idleft); parametrosActuales.add("int"); :}
            | INT SEPARADOR IDENTIFICADOR:id array parametro_resto
                {: agregarSimbolo((String)id, "int[][]", idleft); parametrosActuales.add("int[][]"); :}
            | FLOAT SEPARADOR IDENTIFICADOR:id array parametro_resto
                {: agregarSimbolo((String)id, "float[][]", idleft); parametrosActuales.add("float[][]"); :}
            | FLOAT SEPARADOR IDENTIFICADOR:id parametro_resto
                {: agregarSimbolo((String)id, "float", idleft); parametrosActuales.add("float"); :}
            | BOOL SEPARADOR IDENTIFICADOR:id parametro_resto
                {: agregarSimbolo((String)id, "bool", idleft); parametrosActuales.add("bool"); :}
            | CHAR SEPARADOR IDENTIFICADOR:id parametro_resto
                {: agregarSimbolo((String)id, "char", idleft); parametrosActuales.add("char"); :}
            | STRING SEPARADOR IDENTIFICADOR:id parametro_resto
                {: agregarSimbolo((String)id, "string", idleft); parametrosActuales.add("string"); :} ;

/* Valor por defecto opcional para parametro */
parametro_resto ::= /* vacio */ 
                    | ASIGNACION valor;



/* Lista de argumentos en llamada a funcion (puede estar vacia) */
argumentos ::= lista_argumentos | /* vacio */ ;

/* Argumentos separados por coma */
lista_argumentos ::= expresion:e 
                        {: argumentosActuales.add((String)e); :}
                   | expresion:e 
                        {: argumentosActuales.add((String)e); :}
                     COMA lista_argumentos ;

/* Sentencias */
sentencia ::= declaracion
            | asignacion
            | return_sentencia
            | break_sentencia
            | if_sentencia
            | do_while_sentencia
            | switch_sentencia
            | cin_sentencia
            | cout_sentencia
            | expresion DELIMITADOR_EXP
            | error DELIMITADOR_EXP;

/* Declaraciones */
declaracion ::=  INT SEPARADOR IDENTIFICADOR:id
                    {: tipoDeclaracionActual = "int"; agregarSimbolo((String)id, "int", idleft); :}
                declaracion_resto:r
                    {: if (r != null) actualizarTipoSimbolo((String)id, tipoDeclaracionActual + r); :}

              | FLOAT SEPARADOR IDENTIFICADOR:id
                    {: tipoDeclaracionActual = "float"; agregarSimbolo((String)id, "float", idleft); :}
                declaracion_resto:r
                    {: if (r != null) actualizarTipoSimbolo((String)id, tipoDeclaracionActual + r); :}

              | BOOL SEPARADOR IDENTIFICADOR:id
                    {: tipoDeclaracionActual = "bool"; agregarSimbolo((String)id, "bool", idleft); :}
                declaracion_variable_resto

              | CHAR SEPARADOR IDENTIFICADOR:id
                    {: tipoDeclaracionActual = "char"; agregarSimbolo((String)id, "char", idleft); :}
                declaracion_variable_resto

              | STRING SEPARADOR IDENTIFICADOR:id
                    {: tipoDeclaracionActual = "string"; agregarSimbolo((String)id, "string", idleft); :}
                declaracion_variable_resto

              | error SEPARADOR IDENTIFICADOR declaracion_resto
                    {: System.err.println("[RECUPERACION] Linea " + ((java_cup.runtime.Symbol)CUP$parser$stack.peek()).left 
                        + ": Tipo no reconocido, se asume 'int'"); :};
declaracion_resto ::= declaracion_variable_resto
                        {: RESULT = null; :}
                    | array:dim DELIMITADOR_EXP
                        {: RESULT = "[][]"; :}
                    | array:dim ASIGNACION INICIO_BLOQUE lista_valores:v FIN_BLOQUE DELIMITADOR_EXP
                        {: 
                            String tipoBloque = v.contains(":") ? v.split(":")[0] : v;
                            String conteo     = v.contains(":") ? v.split(":")[1] : "0";

                            // Validar tipo
                            if (!tipoBloque.equals(tipoDeclaracionActual) && !tipoBloque.equals("error")) {
                                errorSemantico("Linea " + ((Symbol)CUP$parser$stack.peek()).left + ": tipo incompatible en inicializacion de arreglo, se esperaba '" + tipoDeclaracionActual + "' pero se encontro '" + tipoBloque + "'.");
                            }

                            // Validar dimensiones solo si dim no es null
                            if (dim != null && !tipoBloque.equals("error")) {
                                int filasDecl  = Integer.parseInt(dim.split(",")[0]);
                                int colsDecl   = Integer.parseInt(dim.split(",")[1]);
                                int totalDecl  = filasDecl * colsDecl;
                                int totalBloque = Integer.parseInt(conteo);
                                if (totalDecl != totalBloque) {
                                    errorSemantico("Linea " + ((Symbol)CUP$parser$stack.peek()).left + ": dimensiones del arreglo no coinciden, se declaro " + filasDecl + "x" + colsDecl + " (" + totalDecl + " elementos)" + " pero se inicializo con " + totalBloque + " elemento(s).");
                                }
                            }
                            RESULT = "[][]"; 
                        :}
                    | array:dim ASIGNACION expresion:e DELIMITADOR_EXP
                        {: 
                            errorSemantico("Linea " + eleft 
                                + ": un arreglo bidimensional no puede inicializarse con un valor escalar, use |: ... :|"); 
                            RESULT = "[][]"; 
                        :};

declaracion_variable_resto ::= DELIMITADOR_EXP
    | ASIGNACION expresion:e DELIMITADOR_EXP {: 
          String tipoExp = e.contains("|") ? e.split("\\|")[0] : e;
          validarTipos(tipoDeclaracionActual, tipoExp, "asignacion", eleft);
          String lugarE = e.contains("|") ? e.split("\\|")[1] : e;
          GeneradorCodigo.emitir("    " + "# decl " + tipoDeclaracionActual + " = " + lugarE); :};

/* Lista de valores para inicializar arreglo */              
lista_valores ::= valor_lista:v 
                    {: RESULT = v; :}
                | valor_lista:v COMA lista_valores:r
                    {: 
                        String tipoV = v.contains(":") ? v.split(":")[0] : v;
                        String tipoR = r.contains(":") ? r.split(":")[0] : r;
                        int contV   = v.contains(":") ? Integer.parseInt(v.split(":")[1]) : 1;
                        int contR   = r.contains(":") ? Integer.parseInt(r.split(":")[1]) : 1;

                        if (!tipoV.equals(tipoR) && !tipoV.equals("error") && !tipoR.equals("error")) {
                            errorSemantico("Linea " + ((Symbol)CUP$parser$stack.peek()).left + ": tipos inconsistentes en inicializacion de arreglo, se encontro '" + tipoV + "' y '" + tipoR + "' en la misma lista.");
                            RESULT = "error:0";
                        } else if (tipoV.equals("error") || tipoR.equals("error")) {
                            RESULT = "error:0";
                        } else {
                            RESULT = tipoV + ":" + (contV + contR);
                        }
                    :};

/* Elemento individual en inicializacion de arreglo (puede ser anidado) */
valor_lista ::= expresion:e 
                    {: RESULT = e + ":1"; :}
              | INICIO_BLOQUE lista_valores:v FIN_BLOQUE 
                    {: RESULT = v; :};

/* Asignacion */
asignacion ::= IDENTIFICADOR:id ASIGNACION expresion:e DELIMITADOR_EXP {: 
                   String tipoVar = verificarUso((String)id, idleft);
                   validarTipos(tipoVar, e, "asignacion", idleft);
                   String lugarE = e.contains("|") ? e.split("\\|")[1] : e;
                   GeneradorCodigo.emitir("    " + id + " = " + lugarE); :}
             | acceso_arreglo:arr ASIGNACION expresion:e DELIMITADOR_EXP {:
                   validarTipos(arr, e, "asignacion", ((Symbol)CUP$parser$stack.peek()).left);
                   String lugarArr = arr.contains("|") ? arr.split("\\|")[1] : arr;
                   String lugarE = e.contains("|") ? e.split("\\|")[1] : e;
                   GeneradorCodigo.emitir("    " + lugarArr + " = " + lugarE); :}
             | IDENTIFICADOR error expresion DELIMITADOR_EXP  {: System.err.println("[RECUPERACION] Linea " + ((java_cup.runtime.Symbol)CUP$parser$stack.elementAt(CUP$parser$top-2)).left + ": Operador de asignacion incorrecto, se asume '<-'"); :} ;

/* Llamada a funcion */
llamada_funcion_exp ::= IDENTIFICADOR:id
    {: argumentosActuales = new java.util.ArrayList<>(); :} INICIO_PARENTESIS argumentos FIN_PARENTESIS {:
        if (!tablaFunciones.containsKey((String)id)) {
            errorSemantico("Linea " + idleft + ": funcion '" + id + "' no fue declarada.");
            RESULT = "error";
        } else {
            java.util.ArrayList<String> params = tablaParametros.get((String)id);
            if (params != null && params.size() != argumentosActuales.size()) {
                errorSemantico("Linea " + idleft + ": la funcion '" + id + "' espera " + params.size() + " argumento(s) pero se encontraron " + argumentosActuales.size() + ".");
                RESULT = "error";
            } else if (params != null) {
                for (int i = 0; i < params.size(); i++) {
                    if (!params.get(i).equals(argumentosActuales.get(i)) && !argumentosActuales.get(i).equals("error")) {
                        errorSemantico("Linea " + idleft + ": argumento " + (i+1) + " de funcion '" + id + "' esperaba tipo '" + params.get(i) + "' pero se encontro '" + argumentosActuales.get(i) + "'.");
                    }
                }
                RESULT = tablaFunciones.get((String)id);
            } else {
                RESULT = tablaFunciones.get((String)id);
            }
        }
    :};

/* Return y Break */
return_sentencia ::= RETURN SEPARADOR expresion:e DELIMITADOR_EXP {: validarTipos(tipoFuncionActual, e, "return", eleft); :}
                   | RETURN error DELIMITADOR_EXP {: System.err.println("[RECUPERACION] Linea " + ((java_cup.runtime.Symbol)CUP$parser$stack.peek()).left + ": Expresion de retorno invalida, se asume retorno por defecto"); :};

break_sentencia ::= BREAK DELIMITADOR_EXP {:
        if (nivelBreak == 0) {
            errorSemantico("Linea " + ((java_cup.runtime.Symbol)CUP$parser$stack.peek()).left + ": 'break' fuera de un switch o do-while.");
        } :} ;

/* cin y cout */
cin_sentencia ::= CIN SEPARADOR IDENTIFICADOR:id DELIMITADOR_EXP {: 
        String t = verificarUso((String)id, idleft);
        String tipoT = t.contains("|") ? t.split("\\|")[0] : t;
        if (!tipoT.equals("int") && !tipoT.equals("float") && !tipoT.equals("error")) {
            errorSemantico("Linea " + idleft + ": cin solo puede leer variables int o float, se encontro tipo '" + tipoT + "'.");
        } :};

cout_sentencia ::= COUT SEPARADOR lista_escritura DELIMITADOR_EXP
                 | COUT error DELIMITADOR_EXP {: System.err.println("[RECUPERACION] Linea " + ((java_cup.runtime.Symbol)CUP$parser$stack.peek()).left + ": Escritura invalida, se omite"); :};

lista_escritura ::= elemento_escritura 
                    | elemento_escritura SEPARADOR lista_escritura;

elemento_escritura ::= IDENTIFICADOR | MENOS numero |numero | CADENA | BOOLEANO | CARACTER | acceso_arreglo ;


/* Bloques */
bloque_inicio ::= INICIO_BLOQUE {: pushScope(nombreBloqueActual); nombreBloqueActual = "BLOQUE"; :} ;
bloque_simple ::= bloque_inicio lista_sentencias FIN_BLOQUE {: popScope(); :};
lista_sentencias ::= sentencia lista_sentencias | /* vacio */ ;

if_cabeza ::= IF INICIO_PARENTESIS expresion:e FIN_PARENTESIS{: 
                  if (!e.equals("bool") && !e.equals("error")) {
                      errorSemantico("Linea " + eleft
                          + ": la condicion del if debe ser de tipo bool, se encontro '" + e + "'.");
                  }
                  contadorIf++; nombreBloqueActual = "IF " + contadorIf; :} ;

else_cabeza  ::= ELSE {: contadorElse++;  nombreBloqueActual = "ELSE "  + contadorElse; :} ;
while_cabeza ::= DO {: contadorWhile++; nivelBreak++; nombreBloqueActual = "DO-WHILE " + contadorWhile; :} ;

if_sentencia ::= if_cabeza bloque_simple
               | if_cabeza bloque_simple else_cabeza bloque_simple
               | IF error bloque_simple {: System.err.println("[RECUPERACION] Linea " + ((java_cup.runtime.Symbol)CUP$parser$stack.peek()).left + ": Condicion de if invalida, se asume verdadero"); :};

do_while_sentencia ::= while_cabeza bloque_simple WHILE INICIO_PARENTESIS expresion:e FIN_PARENTESIS DELIMITADOR_EXP{:
        nivelBreak--;
        if (!e.equals("bool") && !e.equals("error")) {
            errorSemantico("Linea " + eleft + ": la condicion del do-while debe ser de tipo bool, se encontro '" + e + "'.");
        } :} ;

switch_sentencia ::= SWITCH SEPARADOR INICIO_PARENTESIS expresion FIN_PARENTESIS {: contadorSwitch++; switchActual = contadorSwitch; casoActual = 0; nivelBreak++; pushScope("SWITCH " + switchActual); :} INICIO_BLOQUE lista_casos FIN_BLOQUE {: nivelBreak--; popScope(); :}
                   | SWITCH error INICIO_BLOQUE lista_casos FIN_BLOQUE {: System.err.println("[RECUPERACION] Linea " + ((java_cup.runtime.Symbol)CUP$parser$stack.peek()).left + ": Switch invalido, se omite"); :};

/* Casos del switch incluyendo opcional default */
lista_casos ::= lista_caso_simple caso_default
                | lista_caso_simple
                | caso_default;

/* Lista de uno o mas cases */
lista_caso_simple ::= caso lista_caso_simple | caso ;

/* Etiqueta case con su bloque de sentencias. punto s: ~ entre case/default y expresion/identificador */
caso ::= CASE SEPARADOR casoConstante DOS_PUNTOS {: casoActual++; :} lista_sentencias 
       | CASE error DOS_PUNTOS lista_sentencias  {: System.err.println("[RECUPERACION] Linea " + ((java_cup.runtime.Symbol)CUP$parser$stack.peek()).left + ": Case invalido, se omite"); :};

/* Etiqueta default (opcional) */
caso_default ::= DEFAULT DOS_PUNTOS lista_sentencias;

expresion ::= exp_logica:e{: RESULT = e; :};

exp_logica ::= exp_relacional:e1 resto_logica:r
                    {: String tipo = e1;
                        if (r != null && !r.equals("error")) {
                            // Los operadores logicos (@ y #) siempre devuelven bool
                            if (!e1.equals("bool") || !r.equals("bool")) {
                                errorSemantico("Linea " + ((Symbol)CUP$parser$stack.peek()).left + ": Operadores logicos requieren tipos bool.");
                                tipo = "error";
                            } else {
                                tipo = "bool";
                            }
                        }
                        RESULT = tipo; :};

/* Operadores logicos binarios en cadena (and, or) */
resto_logica ::= OPERADOR_LOGICO_BINARIO exp_relacional:e resto_logica:r {: RESULT = e; :}
                | /* vacio */ {: RESULT = null; :};

exp_relacional ::= LESS_T INICIO_PARENTESIS exp_aritmetica:e1 COMA exp_aritmetica:e2 FIN_PARENTESIS
                    {: 
                        if ((!e1.equals("int") && !e1.equals("float") && !e1.equals("error")) ||
                            (!e2.equals("int") && !e2.equals("float") && !e2.equals("error"))) {
                            errorSemantico("Linea " + ((Symbol)CUP$parser$stack.peek()).left + ": 'less_t' solo aplica a int o float.");
                            RESULT = "error";
                        } else {
                            RESULT = validarTipos(e1, e2, "less_t", ((Symbol)CUP$parser$stack.peek()).left);
                        }
                    :}
                 | LESS_TE INICIO_PARENTESIS exp_aritmetica:e1 COMA exp_aritmetica:e2 FIN_PARENTESIS
                    {: 
                        if ((!e1.equals("int") && !e1.equals("float") && !e1.equals("error")) ||
                            (!e2.equals("int") && !e2.equals("float") && !e2.equals("error"))) {
                            errorSemantico("Linea " + ((Symbol)CUP$parser$stack.peek()).left + ": 'less_te' solo aplica a int o float.");
                            RESULT = "error";
                        } else {
                            RESULT = validarTipos(e1, e2, "less_te", ((Symbol)CUP$parser$stack.peek()).left);
                        }
                    :}
                 | GREATER_T INICIO_PARENTESIS exp_aritmetica:e1 COMA exp_aritmetica:e2 FIN_PARENTESIS
                    {: 
                        if ((!e1.equals("int") && !e1.equals("float") && !e1.equals("error")) ||
                            (!e2.equals("int") && !e2.equals("float") && !e2.equals("error"))) {
                            errorSemantico("Linea " + ((Symbol)CUP$parser$stack.peek()).left + ": 'greather_t' solo aplica a int o float.");
                            RESULT = "error";
                        } else {
                            RESULT = validarTipos(e1, e2, "greather_t", ((Symbol)CUP$parser$stack.peek()).left);
                        }
                    :}
                 | GREATER_TE INICIO_PARENTESIS exp_aritmetica:e1 COMA exp_aritmetica:e2 FIN_PARENTESIS
                    {: 
                        if ((!e1.equals("int") && !e1.equals("float") && !e1.equals("error")) ||
                            (!e2.equals("int") && !e2.equals("float") && !e2.equals("error"))) {
                            errorSemantico("Linea " + ((Symbol)CUP$parser$stack.peek()).left + ": 'greather_te' solo aplica a int o float.");
                            RESULT = "error";
                        } else {
                            RESULT = validarTipos(e1, e2, "greather_te", ((Symbol)CUP$parser$stack.peek()).left);
                        }
                    :}
                 | EQUAL INICIO_PARENTESIS expresion:e1 COMA expresion:e2 FIN_PARENTESIS
                    {: RESULT = validarTipos(e1, e2, "equal", ((Symbol)CUP$parser$stack.peek()).left); :}
                 | N_EQUAL INICIO_PARENTESIS expresion:e1 COMA expresion:e2 FIN_PARENTESIS
                    {: RESULT = validarTipos(e1, e2, "n_equal", ((Symbol)CUP$parser$stack.peek()).left); :}
                 | exp_aritmetica:e {: RESULT = e; :};

/* punto g: suma y resta */
exp_aritmetica ::= exp_termino:e1 resto_aritmetica:r {: 
                        String tipo1 = e1.contains("|") ? e1.split("\\|")[0] : e1;
                        String lugar1 = e1.contains("|") ? e1.split("\\|")[1] : e1;
                        if (r != null && !r.equals("error|?")) {
                            String op    = r.split("\\|")[0];
                            String lugar2 = r.split("\\|")[1];
                            String tipo2  = r.split("\\|")[2];
                            validarTipos(tipo1, tipo2, "aritmetica", ((Symbol)CUP$parser$stack.peek()).left);
                            String t = GeneradorCodigo.nuevoTemp();
                            GeneradorCodigo.emitir("    " + t + " = " + lugar1 + " " + op + " " + lugar2);
                            RESULT = tipo1 + "|" + t;
                        } else {
                            RESULT = e1;
                        } :};


/* Operadores de suma y resta en cadena */
resto_aritmetica ::= MAS exp_termino:e resto_aritmetica:r {: 
                        String tipo = e.contains("|") ? e.split("\\|")[0] : e;
                        String lugar = e.contains("|") ? e.split("\\|")[1] : e;
                        RESULT = "+|" + lugar + "|" + tipo; :}
                    | MENOS exp_termino:e resto_aritmetica:r {: 
                        String tipo = e.contains("|") ? e.split("\\|")[0] : e;
                        String lugar = e.contains("|") ? e.split("\\|")[1] : e;
                        RESULT = "-|" + lugar + "|" + tipo; :}
                    | /* vacio */  {: RESULT = null; :};

exp_termino ::= exp_factor:e1 resto_termino:r {: 
                    String tipo = e1;
                    if (r != null && !r.equals("error")) {
                        String tipoR = r.contains("|") ? r.split("\\|")[0] : r;
                        String opR   = r.contains("|") ? r.split("\\|")[1] : "*";
                        if (opR.equals("%") && !e1.equals("int") && !e1.equals("error")) {
                            errorSemantico("Linea " + ((Symbol)CUP$parser$stack.peek()).left + ": el operador '%' solo aplica a tipo int, se encontro tipo '" + e1 + "'.");
                            tipo = "error";
                        } else if (opR.equals("%") && !tipoR.equals("int") && !tipoR.equals("error")) {
                            errorSemantico("Linea " + ((Symbol)CUP$parser$stack.peek()).left + ": el operador '%' solo aplica a tipo int, se encontro tipo '" + tipoR + "'.");
                            tipo = "error";
                        } else {
                            String nombreOp = opR.equals("*") ? "multiplicacion" 
                                           : opR.equals("/") ? "division" 
                                           : "modulo";
                            tipo = validarTipos(e1, tipoR, nombreOp, ((Symbol)CUP$parser$stack.peek()).left);
                        }
                    }
                    RESULT = tipo;
                :};


/* Operadores de multiplicacion, division y modulo en cadena */
resto_termino ::= MULTIPLICACION exp_factor:e resto_termino:r {: RESULT = e + "|*"; :}
                | DIVISION exp_factor:e resto_termino:r       {: RESULT = e + "|/"; :}
                | MODULO exp_factor:e resto_termino:r         {: RESULT = e + "|%"; :}
                | /* vacio */ {: RESULT = null; :};


/* punto g: potencia */
exp_potencia ::= valor:e1 resto_potencia:r
                    {:  String tipo = e1;
                        if (r != null && !r.equals("error")) {
                            tipo = validarTipos(e1, r, "potencia", ((Symbol)CUP$parser$stack.peek()).left);
                        } RESULT = tipo; :};

/* Operador potencia en cadena */
resto_potencia ::= POTENCIA valor:e resto_potencia:r {:  RESULT = e;:}
                | /* vacio */  {: RESULT = null; :};

exp_factor ::= MENOS numero:n {: RESULT = n; :}
             | INCREMENTO IDENTIFICADOR:id
                {: 
                    String t = verificarUso((String)id, idleft);
                    if (!t.equals("int") && !t.equals("float") && !t.equals("error")) {
                        errorSemantico("Linea " + idleft + ": '++' solo aplica a variables int o float, se encontro tipo '" + t + "'.");
                    }
                    RESULT = t; 
                :}
             | INCREMENTO acceso_arreglo:arr {: RESULT = arr; :}
             | DECREMENTO IDENTIFICADOR:id
                {: 
                    String t = verificarUso((String)id, idleft);
                    if (!t.equals("int") && !t.equals("float") && !t.equals("error")) {
                        errorSemantico("Linea " + idleft + ": '--' solo aplica a variables int o float, se encontro tipo '" + t + "'.");
                    }
                    RESULT = t; 
                :}
             | DECREMENTO acceso_arreglo:arr {: RESULT = arr; :}
             | OPERADOR_LOGICO_UNARIO exp_factor:e {: RESULT = "bool"; :}
             | exp_potencia:e {: RESULT = e; :};

/* Valores permitidos en expresiones: literales, variables, llamadas, etc */
valor ::= numero:n {: RESULT = n; :}
        | IDENTIFICADOR:id {: RESULT = verificarUso((String)id, idleft); :}
        | BOOLEANO:b {:
                String t = GeneradorCodigo.nuevoTemp();
                GeneradorCodigo.emitir("    " + t + " = " + b);
                RESULT = "bool|" + t; :}
        | CADENA:s {:
                String t = GeneradorCodigo.nuevoTemp();
                GeneradorCodigo.emitir("    " + t + " = \"" + s + "\"");
                RESULT = "string|" + t; :}
        | CARACTER:c {:
                String t = GeneradorCodigo.nuevoTemp();
                GeneradorCodigo.emitir("    " + t + " = '" + c + "'");
                RESULT = "char|" + t; :}
        | acceso_arreglo:arr {: RESULT = arr; :}
        | llamada_funcion_exp:lf {: RESULT = lf; :}
        | INICIO_PARENTESIS exp_logica:e FIN_PARENTESIS {: RESULT = e; :} ;
        
/* Arreglos bidimensionales */
/*Error Semantico cambiar si se ocupa*/
array ::= INICIO_INDICE NUMERO_ENTERO:d1 FIN_INDICE INICIO_INDICE NUMERO_ENTERO:d2 FIN_INDICE
            {: RESULT = ((Integer)d1) + "," + ((Integer)d2); :};

/* Acceso a elemento de arreglo bidimensional */
acceso_arreglo ::= IDENTIFICADOR:id INICIO_INDICE exp_aritmetica:e1 FIN_INDICE INICIO_INDICE exp_aritmetica:e2 FIN_INDICE
                   {: 
                       // Verificar que la variable del arreglo exista
                       String tipoArreglo = verificarUso((String)id, idleft);
                       
                       // VERIFICAR QUE SEA UN ARREGLO BIDIMENSIONAL
                       if (!tipoArreglo.endsWith("[][]")) {
                           errorSemantico("Linea " + idleft 
                               + ": La variable '" + id + "' no es un arreglo bidimensional, es de tipo '" + tipoArreglo + "'");
                       }
                       
                       // Verificar que los indices sean ENTEROS (no float)
                       if (!e1.equals("int")) {
                           errorSemantico("Linea " + idleft 
                               + ": Indice de arreglo debe ser int, se encontro '" + e1 + "'");
                       }
                       if (!e2.equals("int")) {
                           errorSemantico("Linea " + ((Symbol)CUP$parser$stack.peek()).left 
                               + ": Indice de arreglo debe ser int, se encontro '" + e2 + "'");
                       }
                       
                       // Extraer tipo base (quitar "[][]")
                       String tipoBase = tipoArreglo;
                       if (tipoBase.endsWith("[][]")) {
                           tipoBase = tipoBase.substring(0, tipoBase.length() - 4);
                       }
                       
                       RESULT = tipoBase;  // "int" o "float"
                   :};